rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Uploaded images awaiting moderation. Owner may write images up to 8 MB.
    // Reads happen through Cloud Functions (Admin SDK); clients cannot read others' files.
    match /users/{uid}/uploads/{file} {
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Child profile photos, uploaded by the parent who manages the child (512 px JPEG, well under 2 MB).
    // Other phones load them through the download URL, which carries its own access token.
    match /users/{uid}/avatars/{file} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType == 'image/jpeg';
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
